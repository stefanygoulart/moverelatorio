# =============================================
# MOVE REPORTS — VARIÁVEIS DE AMBIENTE
# =============================================
# Copie este arquivo para .env.local e preencha

# --- META (Facebook) ---
# Crie seu app em: https://developers.facebook.com/apps
META_APP_ID=SEU_APP_ID_AQUI
META_APP_SECRET=SEU_APP_SECRET_AQUI

# --- NEXTAUTH ---
# Gere uma chave em: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=GERE_UMA_CHAVE_ALEATORIA_AQUI

# Em produção, coloque a URL do seu site na Vercel:
NEXTAUTH_URL=http://localhost:3000

# --- NOME DA AGÊNCIA (aparece nos relatórios) ---
NEXT_PUBLIC_AGENCY_NAME=Move Marketing
NEXT_PUBLIC_AGENCY_TAGLINE=Business Intelligence
